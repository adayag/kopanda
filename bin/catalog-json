#!/usr/bin/env bash
# Prints, as JSON with object keys sorted, what the studio's launcher editor offers from the pinned
# KOReader build: the file-browser actions, the bundled plugins a file manager loads, KoPanda's
# icons and its screen tables. `npm run catalog` in studio/ writes it to studio/src/catalog.json.
#
# A headless KOReader runs bin/catalog-json.lua on the emulator's LuaJIT in a scratch KO_HOME,
# removed on exit. KOReader logs to stdout, so the Lua writes the JSON to a file in the scratch
# and only that file reaches stdout; KOReader's log is shown on stderr when the run fails.
#
# Exit 0 on success, 1 when the dump fails, 2 when the script refuses to run.
set -euo pipefail

KOPANDA_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
emulator_default="$HOME/Projects/kodev/koreader/koreader-emulator-arm64-apple-darwin23.5.0-debug"
KOPANDA_EMULATOR="${KOPANDA_EMULATOR:-$emulator_default/koreader}"

if [[ ! -x "$KOPANDA_EMULATOR/luajit" ]]; then
    printf '%s\n' "bin/catalog-json: no luajit at $KOPANDA_EMULATOR/luajit" \
        "    set KOPANDA_EMULATOR to the emulator's koreader directory" >&2
    exit 2
fi

KO_HOME="$(mktemp -d)"
export KO_HOME
trap 'rm -rf "$KO_HOME"' EXIT

out="$KO_HOME/catalog.json"
log="$KO_HOME/catalog.log"
cd "$KOPANDA_EMULATOR"
# bin/check's paths without the Busted rocks; the Lua puts the plugin folder on package.path
# itself, after KOReader's plugins have loaded.
if KOPANDA_ROOT="$KOPANDA_ROOT" KOPANDA_CATALOG_OUT="$out" \
    LUA_PATH="?.lua;common/?.lua;frontend/?.lua;spec/front/unit/?.lua" \
    LUA_CPATH="?.so;common/?.so" \
    ./luajit "$KOPANDA_ROOT/bin/catalog-json.lua" >"$log"; then
    cat "$out"
else
    status=$?
    cat "$log" >&2
    exit "$status"
fi
