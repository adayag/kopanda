#!/usr/bin/env bash
# KoPanda's gate: luacheck and the studio's typecheck, lint and tests side by side, then Busted specs on the
# emulator's LuaJIT, each layer split across parallel shards under a fresh KO_HOME apiece.
#
#   bin/check              lint, studio, unit specs, emulator specs; stops at the first failing stage;
#                          needs node on PATH and studio/node_modules (npm ci --prefix studio)
#   bin/check --lint       luacheck alone
#   bin/check --unit       lint, studio, unit specs; stops before spec/emulator/ (the task gate);
#                          needs what the full run needs
#   bin/check <spec>...    exactly those spec files in one Busted process, no luacheck
#   --verbose              with any of the above: luacheck's per-file lines and Busted's full gtest
#                          output, KOReader's library-loading chatter included
#
# The unit layer runs in KOPANDA_CHECK_JOBS shards (default: the core count, at most 8), the emulator layer in
# KOPANDA_CHECK_EMULATOR_JOBS (default 4). An emulator spec that names paint_budget in any case (PAINT_BUDGET_MS too)
# judges a capture's wall time, which a loaded host stretches, so those specs run after the rest, one Busted process
# for them all, once the host's 1-minute load average is at or below its core count (spec/emulator/paint_budget.lua's
# judges_wall), waiting at most 120 s for it.
#
# Without --verbose each stage prints luacheck's total or Busted's suite summary, one per layer summing its shards,
# plus each file with a failing test and Busted's failure blocks in full, and any line a test starts with
# "[  NOTE    ] ".
#
# Exit 0 on success, 1 when a stage fails, 2 when the script refuses to run.
set -euo pipefail

KOPANDA_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
emulator_default="$HOME/Projects/kodev/koreader/koreader-emulator-arm64-apple-darwin23.5.0-debug"
KOPANDA_EMULATOR="${KOPANDA_EMULATOR:-$emulator_default/koreader}"
export KOPANDA_ROOT KOPANDA_EMULATOR

refuse() {
    printf '%s\n' "$@" >&2
    exit 2
}

if ! command -v luacheck >/dev/null 2>&1; then
    refuse "bin/check: luacheck is not on PATH" "    brew install luacheck"
fi
if [[ ! -x "$KOPANDA_EMULATOR/luajit" ]]; then
    refuse "bin/check: no luajit at $KOPANDA_EMULATOR/luajit" \
        "    set KOPANDA_EMULATOR to the emulator's koreader directory"
fi

cores="$(sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
unit_jobs="${KOPANDA_CHECK_JOBS:-$((cores < 8 ? cores : 8))}"
emulator_jobs="${KOPANDA_CHECK_EMULATOR_JOBS:-4}"
if [[ ! "$unit_jobs" =~ ^[1-9][0-9]*$ ]]; then
    refuse "bin/check: KOPANDA_CHECK_JOBS is $unit_jobs, not a positive whole number"
fi
if [[ ! "$emulator_jobs" =~ ^[1-9][0-9]*$ ]]; then
    refuse "bin/check: KOPANDA_CHECK_EMULATOR_JOBS is $emulator_jobs, not a positive whole number"
fi

verbose=0
args=()
for arg in "$@"; do
    if [[ "$arg" == "--verbose" ]]; then
        verbose=1
    else
        args+=("$arg")
    fi
done
set -- ${args[@]+"${args[@]}"}

mode=specs
if [[ $# -eq 0 ]]; then
    mode=all
elif [[ $# -eq 1 && "$1" == "--lint" ]]; then
    mode=lint
elif [[ $# -eq 1 && "$1" == "--unit" ]]; then
    mode=unit
fi

if [[ "$mode" == all || "$mode" == unit ]]; then
    if ! command -v node >/dev/null 2>&1; then
        refuse "bin/check: node is not on PATH" "    brew install node" "    npm ci --prefix studio"
    fi
    if [[ ! -d "$KOPANDA_ROOT/studio/node_modules" ]]; then
        refuse "bin/check: no studio/node_modules" "    npm ci --prefix studio"
    fi
fi

# Named specs run under this KO_HOME; a shard runs under a fresh one made inside it, beside the stages' output.
KO_HOME="$(mktemp -d)"
export KO_HOME

# Kills a process and every process under it, children first: a background job ignores SIGINT, and killing only the
# job's subshell would leave its luajit, KOReader or npm running.
kill_tree() {
    local child
    for child in $(pgrep -P "$1"); do
        kill_tree "$child"
    done
    kill "$1" 2>/dev/null || true
}

cleanup() {
    local job
    for job in $(jobs -p); do
        kill_tree "$job"
    done
    rm -rf "$KO_HOME"
}
trap cleanup EXIT
printf 'KOPANDA_KO_HOME=%s\n' "$KO_HOME"

run_lint() {
    echo "== lint: luacheck"
    if [[ $verbose -eq 1 ]]; then
        (cd "$KOPANDA_ROOT" && luacheck .)
    else
        (cd "$KOPANDA_ROOT" && luacheck --quiet --no-color .)
    fi
}

run_studio() {
    echo "== studio"
    npm --prefix "$KOPANDA_ROOT/studio" run check
}

# Runs luacheck and the studio's check at once and prints their output in that order; fails when either does.
run_lint_and_studio() {
    local lint_status=0 studio_status=0 lint_pid studio_pid
    run_lint >"$KO_HOME/lint.out" 2>&1 &
    lint_pid=$!
    run_studio >"$KO_HOME/studio.out" 2>&1 &
    studio_pid=$!
    wait "$lint_pid" || lint_status=$?
    wait "$studio_pid" || studio_status=$?
    cat "$KO_HOME/lint.out" "$KO_HOME/studio.out"
    [[ $lint_status -eq 0 && $studio_status -eq 0 ]]
}

# Reads Busted's gtest output and keeps what a reader needs: a test's lines only when it fails or
# errors, after the name of its file, except a line it starts with "[  NOTE    ] ", kept as it comes
# (the paint budget's word that it didn't judge wall time); Busted's own messages, such as a spec
# file that does not load; and the suite summary, failing when there is none. A test that ends the process is
# printed after its [ RUN ] line, the only place its name appears. It drops gtest's per-file and per-test lines and
# the lines KOReader's ffi/loadlib.lua:59,68,72,91,106,136,168-170 logs whenever a process loads a library.
summarize() {
    awk -v root="$KOPANDA_ROOT/" '
        /^(has monolibtic\? |lib_(search_path|basic_format|version_format): |ffi\.(findlib|load): |package\.loadlib: )/ {
            next
        }
        summary { print; next }
        /^\[==========\] [0-9]+ tests? from / { summary = 1; print; next }
        /^\[----------\] Running tests from / {
            file = $0
            sub(/^\[----------\] Running tests from /, "", file)
            if (index(file, root) == 1) file = substr(file, length(root) + 1)
        }
        /^\[ RUN      \] / { intest = 1; buffered = 0; running = $0; next }
        /^\[  NOTE    \] / { print; next }
        intest && /^\[(       OK | SKIPPED  )\] / { intest = 0; next }
        intest && /^\[(  FAILED  |  ERROR   )\] / { buffer[++buffered] = $0; intest = 0; flush(); next }
        intest { buffer[++buffered] = $0; next }
        /^\[(==========|----------)\] / || /^$/ { next }
        { print }
        function flush(first,    i) {
            if (!(file in named)) print "[  FAILED  ] in " file
            named[file] = 1
            if (first != "") print first
            for (i = 1; i <= buffered; i++) print buffer[i]
        }
        END {
            if (intest) flush(running)
            if (!summary) exit 1
        }
    '
}

run_busted() {
    local lua_path="?.lua;common/?.lua;frontend/?.lua;spec/front/unit/?.lua"
    lua_path="$lua_path;spec/rocks/share/lua/5.1/?.lua;spec/rocks/share/lua/5.1/?/init.lua"
    lua_path="$lua_path;$KOPANDA_ROOT/spec/?.lua;$KOPANDA_ROOT/kopanda.koplugin/?.lua"
    local busted=(./luajit -e 'require "busted.runner" {standalone = false}' /dev/null
        --output=gtest --sort-files --helper="$KOPANDA_ROOT/spec/helper.lua" --loaders=lua --lazy)
    cd "$KOPANDA_EMULATOR"
    local lua_cpath='?.so;common/?.so;spec/rocks/lib/lua/5.1/?.so'
    if [[ $verbose -eq 1 ]]; then
        LUA_PATH="$lua_path" LUA_CPATH="$lua_cpath" "${busted[@]}" -- "$@"
    else
        LUA_PATH="$lua_path" LUA_CPATH="$lua_cpath" "${busted[@]}" -- "$@" 2>&1 | summarize
    fi
}

# Runs the specs in at most jobs Busted processes at once, each under a fresh KO_HOME, writing shard n's output to
# <out>.<n> and adding that path to outputs: the largest file goes first, each to the shard with the fewest bytes so
# far. Fails when any shard does or ends without Busted's suite summary.
outputs=()
run_shards() {
    local jobs="$1" out="$2" status=0 n index spec pids=()
    shift 2
    if [[ $jobs -gt $# ]]; then
        jobs=$#
    fi
    for spec in "$@"; do
        printf '%s\t%s\n' "$(wc -c <"$spec" | tr -d ' ')" "$spec"
    done | sort -t $'\t' -k1,1nr -k2,2 | awk -F '\t' -v jobs="$jobs" '{
        best = 1
        for (n = 2; n <= jobs; n++) if (bytes[n] < bytes[best]) best = n
        bytes[best] += $1 + 1
        print best "\t" $2
    }' >"$out.shards"
    for ((n = 1; n <= jobs; n++)); do
        local shard=()
        while IFS=$'\t' read -r index spec; do
            if [[ "$index" == "$n" ]]; then
                shard+=("$spec")
            fi
        done <"$out.shards"
        (
            KO_HOME="$(mktemp -d "$KO_HOME/ko_home.XXXXXX")"
            export KO_HOME
            run_busted "${shard[@]}"
        ) >"$out.$n" 2>&1 &
        pids+=($!)
        outputs+=("$out.$n")
    done
    for ((n = 1; n <= jobs; n++)); do
        wait "${pids[n - 1]}" || status=1
        grep -q '^\[==========\] [0-9]* tests* from ' "$out.$n" || status=1
    done
    return $status
}

# Prints the shards' output files in order with their suite summaries merged into one: the counts summed, the listed
# tests in shard order, the time the longest shard's.
combine() {
    awk '
        FNR == 1 { insummary = 0; section = "" }
        /^\[==========\] [0-9]+ tests? from [0-9]+ test files? ran\. \([0-9.]+ ms total\)$/ {
            insummary = 1; summaries++
            tests += $2; files += $5
            ms = $(NF - 2); sub(/^\(/, "", ms); if (ms + 0 > longest) longest = ms + 0
            next
        }
        !insummary { print; next }
        /^\[  PASSED  \] [0-9]+ tests?\.$/ { passed += $4; next }
        /^\[ SKIPPED  \] [0-9]+ tests?, listed below:$/ { section = "skipped"; skipped += $4; next }
        /^\[  FAILED  \] [0-9]+ tests?, listed below:$/ { section = "failed"; failed += $4; next }
        /^\[  ERROR   \] [0-9]+ errors?, listed below:$/ { section = "error"; errors += $4; next }
        section == "skipped" && /^\[ SKIPPED  \] / { listed["skipped"] = listed["skipped"] $0 "\n"; next }
        section == "failed" && /^\[  FAILED  \] / { listed["failed"] = listed["failed"] $0 "\n"; next }
        section == "error" && /^\[  ERROR   \] / { listed["error"] = listed["error"] $0 "\n"; next }
        /^$/ || /^ [0-9]+ (SKIPPED TESTS?|FAILED TESTS?|ERRORS?)$/ { next }
        { after = after $0 "\n" }
        function plural(count, word) { return count == 1 ? word : word (word ~ /^[A-Z]+$/ ? "S" : "s") }
        END {
            if (summaries == 0) { printf "%s", after; exit }
            printf "[==========] %d %s from %d test %s ran. (%.2f ms total)\n", tests, plural(tests, "test"),
                files, plural(files, "file"), longest
            printf "[  PASSED  ] %d %s.\n", passed, plural(passed, "test")
            if (skipped) printf "[ SKIPPED  ] %d %s, listed below:\n%s",
                skipped, plural(skipped, "test"), listed["skipped"]
            if (failed) printf "[  FAILED  ] %d %s, listed below:\n%s", failed, plural(failed, "test"), listed["failed"]
            if (errors) printf "[  ERROR   ] %d %s, listed below:\n%s", errors, plural(errors, "error"), listed["error"]
            if (skipped + failed + errors) print ""
            if (skipped) printf " %d SKIPPED %s\n", skipped, plural(skipped, "TEST")
            if (failed) printf " %d FAILED %s\n", failed, plural(failed, "TEST")
            if (errors) printf " %d %s\n", errors, plural(errors, "ERROR")
            printf "%s", after
        }
    ' "$@"
}

# The host's 1-minute load average, or nothing when it can't be read: sysctl on macOS, /proc/loadavg on Linux.
load_average() {
    { sysctl -n vm.loadavg 2>/dev/null || cat /proc/loadavg 2>/dev/null; } | tr -d '{}' | awk '{ print $1 }'
}

over_cores() {
    [[ -n "$1" ]] && awk -v load="$1" -v cores="$cores" 'BEGIN { exit !(load > cores) }'
}

# Waits, at most 120 s, for the host's load to fall to its core count, where paint_budget.lua judges wall time.
settle() {
    local load waited=0
    load="$(load_average)"
    if ! over_cores "$load"; then
        return 0
    fi
    echo "waiting for the host's load $load to fall to $cores cores"
    while over_cores "$load" && [[ $waited -lt 120 ]]; do
        sleep 2
        waited=$((waited + 2))
        load="$(load_average)"
    done
    if over_cores "$load"; then
        echo "the host's load is still $load after 120 s; the paint budget will not judge wall time"
    fi
}

# Runs every spec under spec/<layer>/ in shards, then, for the emulator layer, its paint-budget specs on a settled
# host; prints the layer's output with one summary. A missing or empty layer is a clean no-op.
run_layer() {
    local layer="$1" dir="$KOPANDA_ROOT/spec/$1" jobs="$2" spec status=0 batch=() budget=()
    echo "== $layer"
    outputs=()
    if [[ -d "$dir" ]]; then
        while IFS= read -r spec; do
            if [[ "$layer" == emulator ]] && grep -qi paint_budget "$spec"; then
                budget+=("$spec")
            else
                batch+=("$spec")
            fi
        done < <(find "$dir" -name '*_spec.lua' -type f | sort)
    fi
    if [[ $((${#batch[@]} + ${#budget[@]})) -eq 0 ]]; then
        echo "no specs under spec/$layer"
        return 0
    fi
    if [[ ${#batch[@]} -gt 0 ]]; then
        run_shards "$jobs" "$KO_HOME/$layer" "${batch[@]}" || status=1
    fi
    if [[ ${#budget[@]} -gt 0 ]]; then
        settle
        run_shards 1 "$KO_HOME/$layer-budget" "${budget[@]}" || status=1
    fi
    combine "${outputs[@]}"
    return $status
}

absolute() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$PWD" "$1" ;;
    esac
}

if [[ "$mode" == all || "$mode" == unit ]]; then
    run_lint_and_studio || exit 1
    run_layer unit "$unit_jobs" || exit 1
    if [[ "$mode" == all ]]; then
        run_layer emulator "$emulator_jobs" || exit 1
    fi
elif [[ "$mode" == lint ]]; then
    run_lint || exit 1
else
    specs=()
    for spec in "$@"; do
        [[ -f "$spec" ]] || refuse "bin/check: no such spec file: $spec"
        specs+=("$(absolute "$spec")")
    done
    run_busted "${specs[@]}" || exit 1
fi
