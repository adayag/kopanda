# CLAUDE.md is excluded by the global ~/.cvsignore; track it in this repo
!CLAUDE.md

# Test artefacts: scratch KO_HOME profiles, captures, luacheck cache.
/spec/.artifacts/
/spec/.cache/

# Tiller-generated, not source. Safe to delete; Tiller re-runs the gates and
# regenerates the cache. Keep these out of your code diff.
/artifacts/tiller/
/.tiller/.cache/
/.bin/
# Per-checkout identity (who you are here), written by `tiller join`; never commit it.
/.tiller/identity.yml
# Per-checkout settings (console preferences and the like), hand-edited; never commit it.
/.tiller/local.yml
# Tiller skill shims (installed per machine by `tiller join`; not source).
/.claude/skills/tiller-*/
