# The KOReader emulator's koreader directory: holds ./luajit, frontend/ and the
# Busted rocks under spec/rocks/. bin/check runs every spec from inside it.
KOPANDA_EMULATOR=$HOME/Projects/kodev/koreader/koreader-emulator-arm64-apple-darwin23.5.0-debug/koreader

# Set by spec/emulator/driver.lua for each emulator run, never by hand: the PNG the capture
# userpatch writes once the plugin signals KoPandaSettled, the seconds it waits before
# shooting anyway and quitting with exit code 3, and the signal's screen it shoots on
# (a capture's shot_screen; signals for other screens are ignored).
KOPANDA_SHOT=
KOPANDA_SHOT_CAP_S=20
KOPANDA_SHOT_SCREEN=home

# Set by spec/emulator/home_capture_spec.lua, night_toggle_spec.lua, capture_inputs_spec.lua,
# preview_spec.lua and the other emulator specs that start from the home, and by bin/preview.lua,
# through the driver's env option, never by hand: the home fixture patch's scenario (populated,
# typecover or empty), the look it stores (unset: the default, Diner), and the latitude,
# longitude and units (fahrenheit or celsius) its weather reading is for, all three or none
# (none: the schema's defaults, Chicago in fahrenheit). An empty value is unset. Those captures
# also run with TZ=America/Chicago.
KOPANDA_HOME_FIXTURE=
KOPANDA_HOME_LOOK=
KOPANDA_HOME_WEATHER_LATITUDE=
KOPANDA_HOME_WEATHER_LONGITUDE=
KOPANDA_HOME_WEATHER_UNITS=

# Set by spec/emulator/night_toggle_spec.lua through the driver's env option, never by hand: how
# the night-toggle scenario patch turns night mode on under the home (menu: the menu's
# ToggleNightMode broadcast; dispatcher: Dispatcher's night_mode action).
KOPANDA_NIGHT_ROUTE=

# Set by spec/emulator/screens_capture_spec.lua through the driver's env option, never by hand:
# the screen the screens scenario patch opens over the home once it settles (layout: edit layout
# with row 2 selected; launcher: launcher management over a stored launcher with a Tools folder).
KOPANDA_SCREEN=

# Set by spec/emulator/library_capture_spec.lua through the driver's env option, never by hand: the
# capture library the spec built (its root, stored as KOReader's home folder, and one sub-folder),
# and what the library scenario patch does once the library opens from the launcher (root: nothing;
# folder: the library opens in the sub-folder; sort: a tap on the sort picker; book: a book opened
# from the library and closed back to it).
KOPANDA_LIBRARY_DIR=
KOPANDA_LIBRARY_STEP=

# Set by spec/emulator/series_authors_capture_spec.lua through the driver's env option, never by
# hand: the capture library the spec built (stored as KOReader's home folder), and the view the
# series-and-authors scenario patch shows once the home settles (series-list, series-books,
# authors-list or author-books).
KOPANDA_SHELF_DIR=
KOPANDA_SHELF_VIEW=

# Set by spec/emulator/push_spec.lua through the driver's env option, never by hand: the studio
# address (host:port of the spec's own file server) and profile the push-pull scenario patch pulls
# from, and the file the notices scenario patch appends each shown InfoMessage's text to.
KOPANDA_PUSH_ADDRESS=
KOPANDA_PUSH_PROFILE=
KOPANDA_NOTICES=

# Set to 1 by hand, for one deliberate run of studio/test/core/settings-written.test.ts, to write
# spec/fixtures/studio/settings_written.lua instead of comparing against it:
# KOPANDA_UPDATE_GOLDENS=1 npm --prefix studio test -- test/core/settings-written.test.ts; then
# bin/check spec/unit/studio_settings_file_spec.lua must pass on the new file. Unset (or anything
# but 1), the fixture is only read.
KOPANDA_UPDATE_GOLDENS=

# The studio server's port: npm start serves the UI and the API on it, and under npm run dev the
# Vite dev server proxies /api to it. An integer 1-65535; unset or empty: 4490.
KOPANDA_STUDIO_PORT=

# The address the studio server binds. Unset or empty: 127.0.0.1, this Mac only. 0.0.0.0 serves
# the LAN so a Kindle can pull a profile's bundle; other machines then reach only the health check
# and the push routes (/api/health, /api/push/...), with no authentication.
KOPANDA_STUDIO_HOST=

# The directory holding the studio's device profiles; ~ or a leading ~/ is the home directory.
# Unset or empty: ~/.kopanda/profiles. A missing directory is created holding the Colorsoft and
# Paperwhite profiles.
KOPANDA_STUDIO_PROFILES_DIR=
